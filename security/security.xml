<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="module_category_sales_quotation_approval" model="ir.module.category">
        <field name="name">RFQ Approval Levels</field>
        <field name="description">RFQ Confirmation Approval Levels</field>
        <field name="sequence">10</field>
        <field name="parent_id" ref="base.module_category_sales"/>
        <field name="exclusive" eval="True"/>
    </record>

    <record id="group_sales_quotation_level_one_approver" model="res.groups">
        <field name="name">Level 1 Approver</field>
        <field name="category_id" ref="module_category_sales_quotation_approval"/>
        <field name="comment">Can approve sales quotations up to Level 1 amount</field>
    </record>

    <record id="group_sales_quotation_level_two_approver" model="res.groups">
        <field name="name">Level 2 Approver</field>
        <field name="category_id" ref="module_category_sales_quotation_approval"/>
        <field name="comment">Can approve sales quotations up to Level 2 amount</field>
        <field name="implied_ids" eval="[(4, ref('rfq_confirmation_levels.group_sales_quotation_level_one_approver'))]"/>
    </record>

    <record id="group_sales_quotation_level_three_approver" model="res.groups">
        <field name="name">Level 3 Approver</field>
        <field name="category_id" ref="module_category_sales_quotation_approval"/>
        <field name="comment">Can approve sales quotations up to Level 3 amount</field>
        <field name="implied_ids" eval="[(4, ref('rfq_confirmation_levels.group_sales_quotation_level_two_approver'))]"/>
    </record>

    <record id="group_sales_quotation_level_four_approver" model="res.groups">
        <field name="name">Level 4 Approver</field>
        <field name="category_id" ref="module_category_sales_quotation_approval"/>
        <field name="comment">Can approve sales quotations of any amount</field>
        <field name="implied_ids" eval="[(4, ref('rfq_confirmation_levels.group_sales_quotation_level_three_approver'))]"/>
    </record>
</odoo>