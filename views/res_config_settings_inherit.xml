<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_inherit_rfq_confirmation_levels" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.approval.levels</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='catalog_setting_container']" position="after">
                <block title="RFQ Confirmation Allowed Levels" name="rfq_levels_confirmations">
                    <setting string="Level One User Limit" help="Set the limit for Level One approvals" id="level_one_limit">
                        <field name="level_one_limit"/>
                    </setting>
                    <setting string="Level Two User Limit" help="Set the limit for Level Two approvals" id="level_two_limit">
                        <field name="level_two_limit"/>
                    </setting>
                    <setting string="Level Three User Limit" help="Set the limit for Level Three approvals" id="level_three_limit">
                        <field name="level_three_limit"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>