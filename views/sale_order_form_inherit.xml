<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="sale_order_form_inherit_rfq_confirmation" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rfq.confirmation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="can_confirm_order" invisible="1"/>
            </xpath>
            
            <xpath expr="//button[@name='action_confirm'][1]" position="attributes">
                <attribute name="invisible">not can_confirm_order or state not in ('sent')</attribute>
            </xpath>

            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">not can_confirm_order or state not in ('draft')</attribute>
            </xpath>
        </field>
    </record>
</odoo>